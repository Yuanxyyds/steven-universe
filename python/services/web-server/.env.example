# === LXC Deployment Configuration (for deploy.sh script) ===
# Configure SSH host in ~/.ssh/config first, then use the host alias here
LXC_HOST=lxc-host-alias

# Application Configuration
APP_NAME="Web Server API Gateway"
APP_VERSION="1.0.0"
LOG_LEVEL=INFO

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Host Server Configuration
# Specifies which server this instance is running on (us-west or us-east)
HOST_SERVER=us-west

# Proxmox Server Configuration
PROXMOX_VERIFY_SSL=false
# US-West Proxmox Server
PROXMOX_US_WEST_API_URL=https://proxmox-west.example.com:8006/api2/json
PROXMOX_US_WEST_API_TOKEN=PVEAPIToken=root@pam!web-server=your-token-here
# US-East Proxmox Server (Backup)
PROXMOX_US_EAST_API_URL=https://proxmox-east.example.com:8006/api2/json
PROXMOX_US_EAST_API_TOKEN=PVEAPIToken=root@pam!web-server=your-token-here

# Downstream Microservices
STEVENAI_SERVICE_URL=http://localhost:8000
STEVENAI_SERVICE_API_KEY=your-stevenai-service-api-key-here
FOOD101_SERVICE_URL=http://localhost:8002
LANDSINK_SERVICE_URL=http://localhost:8003

# File Service Integration
FILE_SERVICE_URL=https://file-service.example.com
FILE_SERVICE_API_KEY=your-file-service-api-key-here

# GPU Service Integration
GPU_SERVICE_URL=https://gpu-service.example.com:8001
GPU_SERVICE_API_KEY=your-gpu-service-api-key-here
